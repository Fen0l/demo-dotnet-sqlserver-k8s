###############################################################################
#  SqlProbe PoC — configuration & credentials
#
#    cp .env.example .env && vi .env        (.env is git-ignored)
#
#  Used by BOTH:  docker run --env-file .env ...   and   scripts/*.sh
#  Docker's --env-file takes values literally: NO quotes, NO inline comments.
###############################################################################

# ── SQL SERVER target ─────────────────────────────────────────────────────────
# FQDN,port. Must be the FQDN for Kerberos (SPN MSSQLSvc/<fqdn>:<port>).
SQLPROBE_SERVER=sql01.itcs.local,1433
SQLPROBE_DATABASE=SqlProbe
# integrated = Active Directory user via Kerberos (default) | sql = local SQL login
SQLPROBE_AUTH=integrated
# self-signed SQL cert in the lab
SQLPROBE_TRUST_SERVER_CERT=true

# ── Active Directory user (SQLPROBE_AUTH=integrated) ─────────────────────────
# docker run: the entrypoint runs kinit with KRB5_PASSWORD (or a keytab mounted
# at /krb5/keytab/svc-sqlprobe.keytab) and renews every 4 h.
# k8s: the kinit sidecar uses the keytab Secret; KRB5_PASSWORD is not used.
KRB5_USER=svc-sqlprobe@ITCS.LOCAL
KRB5_PASSWORD=
# KDC host/IP -> krb5.conf generated at start (realm = part after '@' in KRB5_USER)
KRB5_KDC=10.12.54.14

# ── local SQL login (SQLPROBE_AUTH=sql only) ─────────────────────────────────
SQLPROBE_USER=sqlprobe
SQLPROBE_PASSWORD=

# ── NEXUS — image build & push (scripts/build-push.sh) ───────────────────────
# Hosted docker repo (Nexus docker repos are addressed by connector port)
REGISTRY=nexus.corp.local:8443/nkp
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
TAG=0.1.0
# Build-time proxies, empty = public upstreams:
#   BASE_REGISTRY        docker proxy of mcr.microsoft.com      e.g. nexus.corp.local:8443/mcr
#   DEBIAN_IMAGE         debian:trixie-slim via docker.io proxy  e.g. nexus.corp.local:8443/dockerhub/debian:trixie-slim
#   NUGET_SOURCE         NuGet group v3 index                    e.g. https://nexus.corp.local/repository/nuget-group/index.json
#   NUGET_USERNAME/PASSWORD  if the feed needs auth (password goes in as a BuildKit secret)
#   APT_MIRROR           apt proxy of deb.debian.org/debian          (suite trixie)
#   APT_SECURITY_MIRROR  apt proxy of deb.debian.org/debian-security (suite trixie-security)
BASE_REGISTRY=
DEBIAN_IMAGE=
NUGET_SOURCE=
NUGET_USERNAME=
NUGET_PASSWORD=
APT_MIRROR=
APT_SECURITY_MIRROR=

# ── AD admin — only for scripts/create-ad-account-ldap.sh + make-keytab-linux.sh ─
AD_HOST=10.12.54.14
AD_ADMIN_DN=administrator@itcs.local
AD_ADMIN_PASSWORD=
REALM=ITCS.LOCAL
SVC_NAME=svc-sqlprobe
SVC_PASSWORD=
SVC_OU=CN=Users,DC=itcs,DC=local
