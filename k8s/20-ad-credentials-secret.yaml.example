# The AD service account the pod logs in as. Source of truth is CyberArk; in the
# target environment this Secret is written by External Secrets Operator from Vault
# (ExternalSecret -> Secret sqlprobe-ad-credentials). For a manual test:
#   scripts/make-ad-secret.sh        # from KRB5_USER / KRB5_PASSWORD in .env -> k8s/20-ad-credentials-secret.yaml (git-ignored)
# entrypoint.sh runs `kinit` with these, then removes KRB5_PASSWORD from the app's environment.
apiVersion: v1
kind: Secret
metadata:
  name: sqlprobe-ad-credentials
  namespace: sqlprobe
type: Opaque
stringData:
  KRB5_USER: svc-sqlprobe@ITCS.LOCAL
  KRB5_PASSWORD: change-me
