# Generated by scripts/make-keytab-secret.sh -> k8s/20-keytab-secret.yaml (git-ignored).
# Or by hand:
#   kubectl -n sqlprobe create secret generic sqlprobe-keytab \
#     --from-file=svc-sqlprobe.keytab=./svc-sqlprobe.keytab --dry-run=client -o yaml > k8s/20-keytab-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: sqlprobe-keytab
  namespace: sqlprobe
type: Opaque
data:
  svc-sqlprobe.keytab: <base64 of the keytab file>
