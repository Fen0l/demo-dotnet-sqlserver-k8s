# Target-environment variant: External Secrets Operator pulls the AD credentials
# from Vault (which is synced from CyberArk) and writes Secret sqlprobe-ad-credentials.
# Replace 20-ad-credentials-secret.yaml with this file once ESO + Vault are wired.
# Adjust: store name, Vault KV path, key names.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: sqlprobe-ad-credentials
  namespace: sqlprobe
spec:
  refreshInterval: 1h                      # picks up a CyberArk rotation within the hour
  secretStoreRef:
    kind: ClusterSecretStore
    name: vault                            # Vault KV v2, auth method kubernetes
  target:
    name: sqlprobe-ad-credentials
    creationPolicy: Owner
  data:
    - secretKey: KRB5_USER
      remoteRef:
        key: nkp/sqlprobe                  # kv/nkp/sqlprobe
        property: username                 # e.g. svc-sqlprobe@ITCS.LOCAL
    - secretKey: KRB5_PASSWORD
      remoteRef:
        key: nkp/sqlprobe
        property: password
